                    onChange={(v) => updateDeep('footer.companyName', v)}
                  />
                  <InputField
                    label="二쇱냼"
                    value={getValue('footer.address')}
                    onChange={(v) => updateDeep('footer.address', v)}
                  />
                </div>
              )}
