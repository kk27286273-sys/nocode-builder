"use client";

import type { V2Element } from "@/types/builder-v2";

interface ElementEditorProps {
  element?: V2Element;
  onChange: (content: string) => void;
}

export default function ElementEditor({
  element,
  onChange,
}: ElementEditorProps) {
  if (!element) {
    return (
      <aside className="w-80 border-l border-neutral-200 bg-white p-5">
        <h2 className="text-sm font-semibold text-neutral-900">
          ?붿냼 ?몄쭛
        </h2>
        <p className="mt-4 text-sm text-neutral-500">
          誘몃━蹂닿린?먯꽌 ?붿냼瑜??좏깮?섏꽭??
        </p>
      </aside>
    );
  }

  const label =
    element.type === "heading"
      ? "?쒕ぉ"
      : element.type === "button"
        ? "踰꾪듉 臾멸뎄"
        : "蹂몃Ц";

  return (
    <aside className="w-80 border-l border-neutral-200 bg-white p-5">
      <h2 className="text-sm font-semibold text-neutral-900">
        ?붿냼 ?몄쭛
      </h2>

      <p className="mt-4 text-xs text-neutral-500">{label}</p>

      <textarea
        value={element.content}
        onChange={(event) => onChange(event.target.value)}
        rows={5}
        className="mt-2 w-full resize-none rounded-lg border border-neutral-300 p-3 text-sm outline-none focus:border-blue-500"
      />

      <p className="mt-2 text-xs text-neutral-400">
        ?낅젰???댁슜? ?꾩옱 ?붾㈃??利됱떆 諛섏쁺?⑸땲??
      </p>
    </aside>
  );
}
